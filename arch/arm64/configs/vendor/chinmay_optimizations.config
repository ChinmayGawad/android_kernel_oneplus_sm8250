
# ---- Memory Management ----
# KSM (Kernel Same-page Merging) - deduplicates memory pages
CONFIG_KSM=y

# Transparent Huge Pages - better memory performance

# ZRAM - compressed swap (essential for Android)
CONFIG_ZRAM=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y

# Swap & reclaim tuning
CONFIG_SWAP=y
CONFIG_SWP_EMULATION=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_BALANCE_ANON_FILE_RECLAIM=y

# ---- I/O Scheduler ----
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_KYBER=y

# ---- CPU & Scheduling ----
CONFIG_SCHED_WALT=y
CONFIG_SCHED_TUNE=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_SCHED_MC=y
CONFIG_HZ_300=y
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_RCU_FAST_NO_HZ=y
CONFIG_NO_HZ=y
CONFIG_NO_HZ_COMMON=y
CONFIG_NO_HZ_IDLE=y
CONFIG_UCLAMP_TASK_GROUP=y

# ---- Power Management ----
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0
CONFIG_CPU_IDLE=y
CONFIG_ARM_CPUIDLE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_BUS_AUTO_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_PM_WAKELOCKS_GC=n

# ---- Pressure Stall Information (PSI) ----
CONFIG_PSI=y

# ---- Power-save WiFi ----
CONFIG_CFG80211_DEFAULT_PS=y

# ---- Memory Protection ----
CONFIG_CMA=y
CONFIG_CMA_AREAS=16
CONFIG_DMA_CMA=y

# ---- CGroups for better resource management ----
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_HUGETLB=y
